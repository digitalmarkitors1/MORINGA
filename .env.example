# Postgres connection string for the CMS (Supabase: use the "Session pooler" URI).
DATABASE_URI=

# Long random string used to sign admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob token for image uploads. Added automatically when a Blob store
# is connected to the Vercel project. Leave empty locally to store on disk.
BLOB_READ_WRITE_TOKEN=
